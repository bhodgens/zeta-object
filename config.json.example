{
  // Root directory for auto-discovered buckets (default: "./data/")
  "dataDir": "./data/",

  // Address the HTTPS server binds to (default: ":8443").
  // Override at runtime with the ZETAOBJECT_LISTEN_ADDR environment variable
  // (env beats config file).
  "listenAddr": ":8443",

  // TLS certificate and private key paths (defaults: "certs/cert.pem",
  // "certs/key.pem"). Generate with: make certs
  "certFile": "certs/cert.pem",
  "keyFile": "certs/key.pem",

  // Optional protocol frontends. Absent = S3 on "listenAddr" (backward
  // compatible). Each entry: "type" (required), "listenAddr" (optional —
  // omit to share the default listener; set to give this frontend its own
  // TLS port), and, for webdav only, "bucket" (see below). Unknown keys
  // inside an entry ABORT startup (fail-loud).
  //
  // WebDAV (RFC 4918 class-1 subset): mount the server as a drive from
  // macOS Finder, Linux davfs2/gvfs, or Windows. "bucket" present and
  // non-empty ⇒ single-bucket mode ("/" IS that bucket; no bucket concept
  // on the wire); absent ⇒ multi-bucket mode (top-level collections are
  // buckets). All methods require HTTP Basic credentials. See the README
  // "WebDAV frontend" section for the full URL→bucket mapping.
  //
  // "frontends": [
  //   { "type": "s3" },
  //   { "type": "webdav", "listenAddr": ":8444", "bucket": "photos" }
  // ],

  // Optional multi-identity authentication. Absent = the environment
  // credential pair alone (identity "env", full read/write everywhere —
  // byte-identical to pre-multi-identity behavior).
  //
  // Each identity: "name" (required, unique, log-safe), "accessKey"
  // (required, unique across identities AND the env pair), "secretKey"
  // (required), "grants" (optional; absent = full read/write to every
  // bucket; per-bucket values "readonly" | "readwrite", "*" allowed as the
  // wildcard bucket, write implies read), "sshPublicKeys" (optional;
  // reserved for the future SFTP frontend).
  //
  // Denied operations get the standard S3 AccessDenied (403); an unknown
  // access key gets InvalidAccessKeyId. Validation is fail-loud: any
  // duplicate access key or invalid identity ABORTS startup.
  // "identities": [
  //   {
  //     "name": "ci-bot",
  //     "accessKey": "AKIDZETACIBOT01",
  //     "secretKey": "wJalrXUtnFEMIfake",
  //     "grants": { "*": "readwrite", "photos": "readonly" },
  //     "sshPublicKeys": []
  //   }
  // ],

  // Optional authentication settings. "mode" "" (absent = default) requires
  // authentication as usual; "none" enables zero-auth DEV MODE: every
  // request is accepted as an anonymous principal with full read/write.
  // Opt-in only and loud by design — the startup banner reads
  // "WARNING: AUTHENTICATION DISABLED" and every unauthenticated request
  // logs its own WARNING line. Any other value aborts startup.
  // "auth": { "mode": "none" },

  // Custom bucket name -> filesystem path mappings. These buckets appear in
  // ListBuckets alongside auto-discovered buckets, cannot be created or
  // deleted via the S3 API, and may point to any directory (incl. symlinks).
  //
  // Each bucket may also select its storage backend with the object form:
  //   "photos": { "path": "/mnt/storage/photos", "backend": "fs" }
  // The legacy bare-string form and the object form can be mixed freely.
  // "backend" absent or "" selects the default backend ("fs").
  "buckets": {
    "photos": "/mnt/storage/photos",
    "backups": "/var/backups/s3-mirror"
  },

  // Storage backend configurations, keyed by backend type name. Absent ⇒
  // every bucket uses the built-in "fs" backend rooted at dataDir / the
  // bucket's custom path. A bucket naming an UNKNOWN backend aborts
  // startup (never a silent fallback to fs). fs ignores "options"; they
  // exist for future backends (e.g. an S3 proxy's endpoint/region).
  "backends": {
    "fs": { "root": "./data/" }
  }
}

// Credentials are NOT set in this file. They come from the environment:
//   ZETAOBJECT_ACCESS_KEY  (default: "minioadmin")
//   ZETAOBJECT_SECRET_KEY  (default: "minioadmin")
// NOTE: setting either variable to an EMPTY string logs a warning and falls
// back to the default — it does not disable the default credentials.
//   ZETAOBJECT_CONFIG      - path to this config file (default: "config.json")
