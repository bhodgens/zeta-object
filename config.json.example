{
  // Root directory for auto-discovered buckets (default: "./data/")
  "dataDir": "./data/",

  // Address the HTTPS server binds to (default: ":8443").
  // Override at runtime with the ZETAOBJECT_LISTEN_ADDR environment variable
  // (env beats config file).
  "listenAddr": ":8443",

  // TLS certificate and private key paths (defaults: "certs/cert.pem",
  // "certs/key.pem"). Generate with: make certs
  "certFile": "certs/cert.pem",
  "keyFile": "certs/key.pem",

  // Optional protocol frontends. Absent = S3 on "listenAddr" (backward
  // compatible). Each entry: "type" (required), "listenAddr" (optional for
  // HTTP frontends — omit to share the default listener; REQUIRED for the
  // non-HTTP frontends "ftp" and "sftp", which cannot share the HTTPS mux),
  // "bucket" for webdav only, and "options" (protocol-specific string
  // settings; unknown keys inside an entry ABORT startup — fail-loud).
  //
  // WebDAV (RFC 4918 class-1 subset): mount the server as a drive from
  // macOS Finder, Linux davfs2/gvfs, or Windows. "bucket" present and
  // non-empty ⇒ single-bucket mode ("/" IS that bucket; no bucket concept
  // on the wire); absent ⇒ multi-bucket mode (top-level collections are
  // buckets). All methods require HTTP Basic credentials. See the README
  // "WebDAV frontend" section for the full URL→bucket mapping.
  //
  // FTP/FTPS: plain FTP and explicit FTPS (AUTH TLS) on the same port —
  // AUTH TLS reuses the top-level "certFile"/"keyFile" (no new keys).
  // Options: "passivePortMin"/"passivePortMax" (passive data-channel range;
  // default kernel-assigned), "publicIP" (PASV reply address; default
  // listener IP). REST/resume is rejected (no partial transfers).
  //
  // SFTP: the SSH subsystem over its own port. "hostKeyFile" is REQUIRED —
  // the key auto-generates there on first start (ed25519, 0600) and is
  // REUSED after (clients pin host keys). Option "allowPasswordAuth"
  // (default "true"; "false" = public-key only). Identities authenticate by
  // password (accessKey/secretKey) or by "sshPublicKeys" association.
  //
  // ownCloud: the OCS negotiation surface (OCS v1+v2 capabilities,
  // cloud/user) layered over the WebDAV data plane, for the official
  // ownCloud desktop client in classic server account mode. "bucket"
  // behaves exactly like the webdav entry's (single-bucket vs
  // multi-bucket mode). HTTP Basic credentials; unimplemented OCS
  // endpoints (shares, provisioning) answer with a documented 404
  // envelope. Real-client compatibility is unverified until the manual
  // pass in docs/plans/owncloud-2026-09/decision.md §6 is run — see
  // docs/owncloud-compatibility.md.
  //
  // Admin (management API): a separate listener serving a JSON REST surface
  // (NOT the S3 API), authenticated by a TLS client certificate (mTLS). It
  // needs its own "listenAddr" (it cannot share the HTTPS mux) and is
  // LOOPBACK-ONLY by default: a listen address whose host does not resolve
  // entirely to loopback aborts startup unless "allowNonLoopback" is "true".
  // Options: "clientCAFile" (REQUIRED; PEM bundle of trusted client CAs; the
  // client certificate's Subject Common Name is the admin principal),
  // "adminPrincipals" (optional comma-separated CN allow-list; empty admits
  // every CA-verified principal), "allowNonLoopback" (optional; "true" opts
  // out of the loopback guard). See the README "Management API" section.
  //
  // "frontends": [
  //   { "type": "s3" },
  //   { "type": "webdav", "listenAddr": ":8444", "bucket": "photos" },
  //   { "type": "owncloud", "listenAddr": ":8446" },
  //   { "type": "ftp", "listenAddr": ":2121",
  //     "options": { "passivePortMin": "50000", "passivePortMax": "50100" } },
  //   { "type": "sftp", "listenAddr": ":2022",
  //     "options": { "hostKeyFile": "certs/host_ed25519" } },
  //   { "type": "admin", "listenAddr": "127.0.0.1:9443",
  //     "options": { "clientCAFile": "certs/admin-ca.pem",
  //                  "adminPrincipals": "alice,bob",
  //                  "allowNonLoopback": "false" } }
  // ],

  // Optional multi-identity authentication. Absent = the environment
  // credential pair alone (identity "env", full read/write everywhere —
  // byte-identical to pre-multi-identity behavior).
  //
  // Each identity: "name" (required, unique, log-safe), "accessKey"
  // (required, unique across identities AND the env pair), "secretKey"
  // (required), "grants" (optional; absent = full read/write to every
  // bucket; per-bucket values "readonly" | "readwrite", "*" allowed as the
  // bucket, write implies read), "sshPublicKeys" (optional; authorized_keys-
  // format lines. Consumed by the SFTP frontend for public-key auth — one
  // key resolves to exactly one identity across the whole registry).
  //
  // Denied operations get the standard S3 AccessDenied (403); an unknown
  // access key gets InvalidAccessKeyId. Validation is fail-loud: any
  // duplicate access key or invalid identity ABORTS startup.
  // "identities": [
  //   {
  //     "name": "ci-bot",
  //     "accessKey": "AKIDZETACIBOT01",
  //     "secretKey": "wJalrXUtnFEMIfake",
  //     "grants": { "*": "readwrite", "photos": "readonly" },
  //     "sshPublicKeys": []
  //   }
  // ],

  // Optional authentication settings. "mode" "" (absent = default) requires
  // authentication as usual; "none" enables zero-auth DEV MODE: every
  // request is accepted as an anonymous principal with full read/write.
  // Opt-in only and loud by design — the startup banner reads
  // "WARNING: AUTHENTICATION DISABLED" and every unauthenticated request
  // logs its own WARNING line. Any other value aborts startup.
  // "auth": { "mode": "none" },

  // Optional zmetad provider settings (ZFS event history, ?events
  // endpoints). "zmetad_db_path" is the SQLite database the zmetad daemon
  // exports to (default "/var/lib/zfs/zmetad.db"); "zmetad_binary" is the
  // executable used for history purge (default "zmetad" on PATH). The
  // management API exposes purge as POST /purge (it clears event history AND
  // the gap/loss record); the S3 API has no purge route. See the README
  // "Metadata Capability Endpoints (ZFS events)" section.
  // "zmetad_db_path": "/var/lib/zfs/zmetad.db",
  // "zmetad_binary": "zmetad",

  // ZFS-bucket versioning mechanism: "reflink" (default - FICLONE
  // block-clone per-write versions under .metadata/.versions-r/, with
  // the retention cap below; fail-soft on filesystems without block
  // cloning), "sidecar" (true per-write versioning as rewritten
  // copies), "snapshots" (faux versioning from the dataset's existing
  // snapshots), or "both" (reflink merged with sidecar-layout
  // history). Applies to ZFS-backed buckets only; non-ZFS buckets
  // always use the sidecar mechanism. See the README "S3 Versioning"
  // section.
  // "zfs_versioning": "reflink",

  // When true, S3 CreateBucket under dataDir creates a child ZFS dataset
  // (<dataDir dataset>/<bucket>) instead of a plain directory, and
  // DeleteBucket destroys it. Startup aborts unless dataDir is a ZFS
  // mountpoint. Requires the zfs CLI (and permission to create datasets)
  // on the server host. Default false = plain directories everywhere.
  // "zfs_bucket_datasets": true,

  // Path or name of the zfs CLI binary (default "zfs" on PATH).
  // "zfs_binary": "zfs",

  // Reflink-mode version retention: the count of version DATA files
  // retained PER KEY (newest N kept; oldest beyond the cap are pruned
  // with their sidecar entries after each recorded version). 0/unset =
  // unlimited. This is the FALLBACK for buckets that do not set their
  // own per-bucket reflinkRetention (see the buckets object form).
  // "zfs_versioning_reflink_retention": 0,

  // Custom bucket name -> filesystem path mappings. These buckets appear in
  // ListBuckets alongside auto-discovered buckets, cannot be created or
  // deleted via the S3 API, and may point to any directory (incl. symlinks).
  //
  // Each bucket may also select its storage backend with the object form:
  //   "photos": { "path": "/mnt/storage/photos", "backend": "fs" }
  // The object form also carries the per-bucket reflink version-retention
  // cap (reflinkRetention): the count of version files retained PER KEY
  // in THIS bucket. Absent = the server-wide
  // zfs_versioning_reflink_retention fallback; explicit 0 = keep zero
  // version copies (every overwrite discards the previous data);
  // negative aborts startup. Bare-string buckets always use the
  // server-wide value.
  //   "photos": { "path": "/mnt/storage/photos", "backend": "fs", "reflinkRetention": 3 }
  // The legacy bare-string form and the object form can be mixed freely.
  // "backend" absent or "" selects the default backend ("fs").
  "buckets": {
    "photos": "/mnt/storage/photos",
    "backups": "/var/backups/s3-mirror"
  },

  // Storage backend configurations, keyed by backend type name. Absent ⇒
  // every bucket uses the built-in "fs" backend rooted at dataDir / the
  // bucket's custom path. A bucket naming an UNKNOWN backend aborts
  // startup (never a silent fallback to fs). fs ignores "options"; they
  // exist for future backends (e.g. an S3 proxy's endpoint/region).
  "backends": {
    "fs": { "root": "./data/" }
  }
}

// Credentials are NOT set in this file. They come from the environment:
//   ZETAOBJECT_ACCESS_KEY  (default: "zetaadmin")
//   ZETAOBJECT_SECRET_KEY  (default: "zetaadmin")
// NOTE: setting either variable to an EMPTY string logs a warning and falls
// back to the default — it does not disable the default credentials.
//   ZETAOBJECT_CONFIG      - path to this config file (default: "config.json")
