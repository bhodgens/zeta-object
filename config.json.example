{
  // Root directory for auto-discovered buckets (default: "./data/")
  "dataDir": "./data/",

  // Address the HTTPS server binds to (default: ":8443").
  // Override at runtime with the MINIS3_LISTEN_ADDR environment variable
  // (env beats config file).
  "listenAddr": ":8443",

  // TLS certificate and private key paths (defaults: "certs/cert.pem",
  // "certs/key.pem"). Generate with: make certs
  "certFile": "certs/cert.pem",
  "keyFile": "certs/key.pem",

  // Custom bucket name -> filesystem path mappings. These buckets appear in
  // ListBuckets alongside auto-discovered buckets, cannot be created or
  // deleted via the S3 API, and may point to any directory (incl. symlinks).
  "buckets": {
    "photos": "/mnt/storage/photos",
    "backups": "/var/backups/s3-mirror"
  }
}

// Credentials are NOT set in this file. They come from the environment:
//   MINIS3_ACCESS_KEY  (default: "minioadmin")
//   MINIS3_SECRET_KEY  (default: "minioadmin")
// NOTE: setting either variable to an EMPTY string logs a warning and falls
// back to the default — it does not disable the default credentials.
//   MINIS3_CONFIG      - path to this config file (default: "config.json")
