#!/bin/bash
# Pre-commit hook that checks for common error handling anti-patterns.
#
# Scope: ADDED lines only. Scans `git diff --cached` for newly-introduced
# anti-patterns; pre-existing issues in untouched code are not blocked.
#
# This hook detects (newly added):
# - Ignored errors (_ = someFunc())
# - panic(err) in non-test code
# - fmt.Errorf without %w for wrapping (informational, not blocking)
#
# Diff parsing: each staged file's -U0 diff is parsed with awk, which skips
# the `---`/`+++ b/...` file headers, tracks the new-file line number from
# each `@@ -a,b +c,d @@` hunk header, and emits one "lineno<TAB>line" record
# per genuinely added line. Every added line is then checked individually
# against its own line number — headers and hunk markers are never scanned,
# and unchanged context lines can never match. (The previous implementation
# grepped `^\+` — which swallowed the `+++ b/<file>` header as an added
# "line" — and re-found each pattern with a whole-file `grep -nF`, so
# pre-existing lines were double-counted and header text leaked into
# scanned patterns.)
#
# Ported from meept/.githooks/pre-commit-errors.

set -e

# Colors (\033 form — macOS /bin/bash is 3.2 and does not support \e)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Checking error handling patterns (added lines only)${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get staged Go files (excluding test files)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ISSUE_COUNT=0
BLOCK_COUNT=0

echo "Checking files:"
echo "$STAGED_GO_FILES" | sed 's/^/  /'
echo ""

for file in $STAGED_GO_FILES; do
  if [ ! -f "$file" ]; then
    continue
  fi

  # Skip generated code
  if grep -q "^// Code generated" "$file" 2>/dev/null; then
    continue
  fi

  # Extract genuine added lines with their new-file line numbers from the
  # staged diff for THIS file (-U0: context suppressed). See the header
  # comment for why this is awk-parsed rather than grepped.
  ADDED_LINES=$(git diff --cached -U0 -- "$file" 2>/dev/null | awk '
    /^--- /   { next }
    /^\+\+\+ /{ next }
    /^@@ /    {
      split($3, hunk, ",")
      cur = substr(hunk[1], 2) + 0
      next
    }
    /^-/      { next }
    /^ /      { cur++; next }
    /^\+/     { printf "%d\t%s\n", cur, substr($0, 2); cur++; next }
    { next }
  ')

  if [ -z "$ADDED_LINES" ]; then
    continue
  fi

  FILE_ISSUES=""
  BLOCKING_ISSUES=""

  while IFS=$'\t' read -r ln pattern; do
    [ -n "$pattern" ] || continue

    is_comment=0
    if printf '%s' "$pattern" | grep -qE '^[[:space:]]*//'; then
      is_comment=1
    fi

    # ---- Check 1: Ignored errors with `_ = ` (blocking) ----
    if printf '%s' "$pattern" | grep -qF "_ = "; then
      skip=0
      # Skip known safe patterns
      case "$pattern" in
        *WithoutCancel*|*WithoutTimeout*|*WithoutDeadline*) skip=1 ;;
      esac
      # Skip comment lines
      if [ "$skip" -eq 0 ] && [ "$is_comment" -eq 1 ]; then
        skip=1
      fi
      # Skip lines where every "_ = " occurrence sits inside a quoted string
      if [ "$skip" -eq 0 ]; then
        stripped=$(printf '%s' "$pattern" | sed 's/"[^"]*"//g')
        case "$stripped" in
          *"_ = "*) ;;
          *) skip=1 ;;
        esac
      fi
      # Skip comma-ok type assertions: ", _ :=" / ", _ =" paired with ".("
      if [ "$skip" -eq 0 ] && printf '%s' "$pattern" | grep -qE ',\s*_\s*(:=|=)[^=]*\.\('; then
        skip=1
      fi
      # Skip HTTP response-writer writes: after WriteHeader the response is
      # committed and a write error cannot be surfaced; `_, _ = w.Write(...)`
      # is the documented idiom (quality-gates convention).
      if [ "$skip" -eq 0 ] && printf '%s' "$pattern" | grep -qE '^\s*_,\s*_\s*=\s*(w|writer|rw|resp\.)\.Write'; then
        skip=1
      fi
      if [ "$skip" -eq 0 ]; then
        BLOCKING_ISSUES="${BLOCKING_ISSUES}  ❌ Ignored error (_ =):\n    $file:$ln: $pattern\n"
        BLOCK_COUNT=$((BLOCK_COUNT + 1))
      fi
    fi

    # ---- Check 2: panic(err) (blocking) ----
    if [ "$is_comment" -eq 0 ] && printf '%s' "$pattern" | grep -qF "panic(err)"; then
      BLOCKING_ISSUES="${BLOCKING_ISSUES}  ❌ panic(err):\n    $file:$ln: $pattern\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    fi

    # ---- Check 3: fmt.Errorf without %w (informational only — not blocking) ----
    if [ "$is_comment" -eq 0 ] && printf '%s' "$pattern" | grep -qF 'fmt.Errorf(' && ! printf '%s' "$pattern" | grep -q '%w'; then
      FILE_ISSUES="${FILE_ISSUES}  ℹ️  fmt.Errorf without %w (consider wrapping):\n    $file:$ln: $pattern\n"
    fi
  done <<< "$ADDED_LINES"

  if [ -n "$FILE_ISSUES" ]; then
    echo -e "${YELLOW}⚠️  $file:${NC}"
    echo -e "$FILE_ISSUES"
    ISSUE_COUNT=$((ISSUE_COUNT + 1))
  fi

  if [ -n "$BLOCKING_ISSUES" ]; then
    echo -e "${RED}━━━ BLOCKING issues (commit will fail) ━━━${NC}"
    echo -e "$BLOCKING_ISSUES"
  fi
done

# Blocking findings must always fail the hook — even when no informational
# issues exist (ISSUE_COUNT 0). Previously the exit-1 path sat inside the
# ISSUE_COUNT branch, so a commit with only blocking findings passed.
if [ "$BLOCK_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${RED}❌ Commit blocked: $BLOCK_COUNT newly-added ignored-error / panic(err) site(s)${NC}"
  echo ""
  exit 1
fi

if [ "$ISSUE_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}Summary: $ISSUE_COUNT file(s) with potential issues; $BLOCK_COUNT blocking.${NC}"
  echo ""
  echo -e "${BLUE}Error handling best practices:${NC}"
  echo ""
  echo "  // Wrap errors with context:"
  echo "  if err != nil {"
  echo "      return fmt.Errorf('process file: %w', err)"
  echo "  }"
  echo ""
  echo "  // Don't ignore errors:"
  echo "  if _, err := doSomething(); err != nil {  // NOT: _ = doSomething()"
  echo "      return err"
  echo "  }"
  echo ""
  echo -e "${YELLOW}⚠️  Remaining items are informational (fmt.Errorf style). Review encouraged but not required.${NC}"
  echo ""
else
  echo -e "${GREEN}✅ Error handling patterns look good (no new issues in added lines)${NC}"
fi

exit 0
