#!/bin/bash
# Pre-commit hook that runs staticcheck on staged Go packages.
#
# This hook catches real bugs and deprecation that go vet misses:
#   - SA1012 nil context.Context arguments
#   - SA1019 deprecated API usage
#   - SA4004 unconditionally terminated loops
#   - SA4006 unused error values (shadowed error bugs)
#   - SA4011 ineffective break/continue
#   - SA4023 impossible interface comparisons
#   - ST1005 error string formatting
#   - U1000 unused symbols
#
# Requires: staticcheck
#   go install honnef.co/go/tools/cmd/staticcheck@latest
# Gracefully skips when staticcheck is not installed.
#
# Ported from meept/.githooks/pre-commit-staticcheck (mini-s3's module is at
# the repo root; no module-prefix logic).

set -e

# Colors (\033 form — macOS /bin/bash is 3.2 and does not support \e)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running staticcheck on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if staticcheck is installed — graceful skip
if ! command -v staticcheck &> /dev/null; then
  if [ -x "$HOME/go/bin/staticcheck" ]; then
    STATICCHECK="$HOME/go/bin/staticcheck"
  else
    echo -e "${YELLOW}⚠️  staticcheck not installed, skipping${NC}"
    echo ""
    echo "Install with:"
    echo "  go install honnef.co/go/tools/cmd/staticcheck@latest"
    echo ""
    exit 0
  fi
else
  STATICCHECK="staticcheck"
fi

# Get staged Go files (excluding test files for speed)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

# Get unique package directories, excluding vendor/generated
PACKAGES=$(echo "$STAGED_GO_FILES" \
  | grep -v '/vendor/' \
  | grep -v 'zz_generated' \
  | grep -v '\.pb\.go' \
  | xargs -I{} dirname {} \
  | sort -u \
  | sed 's|^|./|')

# Classify each staged package with `go list -e` so a package that FAILS TO
# LOAD is never mistaken for one the default build tags exclude.
# Prints exactly one of:
#   ok
#   excluded|<reason>       default tags exclude every file
#   nested-module|<reason>  separate Go module, not part of this one
#   missing|<reason>        path no longer exists in the working tree
#   nofiles|<reason>        no (non-test) Go files to analyze -> SKIP
#   broken|<reason>         the ONLY fail-closed verdict
go_list_state() {
  local pat="$1" err rc detail
  rc=0
  err="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>/dev/null)" || rc=$?
  err="$(printf '%s\n' "$err" | tr '\n' ' ' | sed 's/ *$//')"
  if [ -z "$err" ]; then
    if [ "$rc" -eq 0 ]; then
      printf 'ok'
      return 0
    fi
    detail="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>&1 >/dev/null | tr '\n' ' ' | sed 's/ *$//')"
    [ -z "$detail" ] && detail="go list exited $rc with no diagnostic"
    printf 'broken|%s' "$detail"
    return 0
  fi
  case "$err" in
    *"build constraints exclude all Go files"*) printf 'excluded|%s' "$err" ;;
    *"no Go files in"*|*"no non-test Go files in"*) printf 'nofiles|%s' "$err" ;;
    *"does not contain package"*)                printf 'nested-module|%s' "$err" ;;
    *"directory not found"*|*"path does not exist"*) printf 'missing|%s' "$err" ;;
    *)                                           printf 'broken|%s' "$err" ;;
  esac
}

PACKAGES_OK=""
for pkg in $PACKAGES; do
  STATE="$(go_list_state "$pkg")"
  case "$STATE" in
    ok)
      PACKAGES_OK="${PACKAGES_OK}${pkg}
" ;;
    excluded*)
      # mini-s3 has no tag-gated packages; report the skip so it cannot look
      # like a pass.
      echo -e "${YELLOW}SKIP(tag-gated) $pkg: ${STATE#*|}; not analyzed${NC}" ;;
    nested-module*|missing*|nofiles*)
      echo -e "${YELLOW}SKIP(${STATE%%|*}) $pkg: ${STATE#*|}${NC}" ;;
    *)
      echo -e "${RED}❌ $pkg could not be loaded — NOT a build-tag exclusion:${NC}"
      echo -e "${RED}   ${STATE#*|}${NC}"
      exit 1 ;;
  esac
done

if [ -z "$PACKAGES_OK" ]; then
  echo -e "${GREEN}✅ No packages to check${NC}"
  exit 0
fi

# Run staticcheck on staged packages.
# Check set rationale (curated 2026-06-19, from meept):
#   SA*              real bugs + deprecations
#   U1000            unused symbols
#   S1008/S1009/etc  simplifications
# Excluded:
#   ST*              style-guide doc-comment rules — low signal
#   SA9003           empty branches (often intentional)
#   S1039            unnecessary fmt.Sprintf (cosmetic, noisy)
STATICCHECK_CHECKS="SA*,U1000,S1008,S1009,S1021,S1034,-SA9003"

set -- $PACKAGES_OK
echo "Checking staged packages:"
printf '  %s\n' "$@"
echo ""

set +e
out=$("$STATICCHECK" -checks "$STATICCHECK_CHECKS" "$@" 2>&1)
rc=$?
set -e
if [ "$rc" -ne 0 ]; then
  echo -e "${RED}❌ staticcheck found issues:${NC}"
  echo ""
  echo "$out"
  echo ""
  echo -e "${YELLOW}Fix these issues before committing.${NC}"
  echo -e "${BLUE}Suppress legitimate findings with //lint:ignore <check> <reason>${NC}"
  echo ""
  exit "$rc"
fi

echo -e "${GREEN}✅ staticcheck passed - no issues found${NC}"
exit 0
