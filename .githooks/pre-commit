#!/bin/bash
# Main pre-commit hook — runs all quality and security checks.
#
# Order:
# 1. gitleaks secret scan (graceful skip when gitleaks is not installed)
# 2. go vet on staged packages          (.githooks/pre-commit-vet)
# 3. Error handling anti-patterns       (.githooks/pre-commit-errors)
# 4. gosec security scan                (.githooks/pre-commit-gosec)
# 5. staticcheck                        (.githooks/pre-commit-staticcheck)
#
# Works on macOS bash 3.2: \033 escape form only, no associative arrays,
# no mapfile. All sub-hooks gracefully skip when their tool is missing.
# Scope: STAGED files only. Bypass with --no-verify for emergencies only.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors (\033 form — macOS /bin/bash is 3.2 and does not support \e)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit Quality Checks (zeta-object)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 1. gitleaks secret scan (graceful skip)
if command -v gitleaks >/dev/null 2>&1; then
  echo -e "${BLUE}[1/5]${NC} Scanning staged content for secrets (gitleaks)..."
  if gitleaks protect --staged --config "$(git rev-parse --show-toplevel)/.gitleaks.toml" --redact; then
    echo -e "${GREEN}✅ No secrets staged${NC}"
  else
    echo -e "${RED}❌ gitleaks detected a secret in staged changes.${NC}"
    echo "   Remove it or add a targeted allowlist entry in .gitleaks.toml."
    exit 1
  fi
else
  echo -e "${YELLOW}[1/5]${NC} gitleaks not installed — skipping secret scan"
  echo "      Install with: brew install gitleaks"
fi
echo ""

# 2. go vet
echo -e "${BLUE}[2/5]${NC} Running go vet..."
"$SCRIPT_DIR/pre-commit-vet" || exit 1
echo ""

# 3. Error handling patterns
echo -e "${BLUE}[3/5]${NC} Checking error handling patterns..."
"$SCRIPT_DIR/pre-commit-errors" || exit 1
echo ""

# 4. gosec security scan (graceful skip inside)
echo -e "${BLUE}[4/5]${NC} Running security scan..."
"$SCRIPT_DIR/pre-commit-gosec" || exit 1
echo ""

# 5. staticcheck (graceful skip inside)
echo -e "${BLUE}[5/5]${NC} Running staticcheck..."
"$SCRIPT_DIR/pre-commit-staticcheck" || exit 1
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

exit 0
