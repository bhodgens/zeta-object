<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- zeta-cache daemon LaunchAgent (leaf 08).
     NOT installed automatically: copy to ~/Library/LaunchAgents/ and
     `launchctl load` it (see the README). Edit the two absolute paths
     below first: the binary location and your zeta-cache.json. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zeta-object.zeta-cache</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/zeta-cache-bin</string>
        <string>-config</string>
        <string>/Users/CHANGE_ME/Library/Application Support/zeta-cache/zeta-cache.json</string>
    </array>

    <!-- Start at login, restart if it crashes (throttled). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/zeta-cache.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/zeta-cache.launchd.err.log</string>

    <!-- The FUSE mount + IPC socket are per-user; do not run when not
         logged in. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
